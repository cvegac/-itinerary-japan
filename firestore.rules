rules_version = '2';

// Reglas del proyecto Firebase viajes-15a78 (solo la app de viajes).
// Este archivo es la única fuente: npm run test:rules (emulador) y después
// npm run deploy:rules. Publicar reemplaza TODAS las reglas del proyecto.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── App de viajes: cada usuario solo lo suyo ──────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function signedIn() {
      return request.auth != null;
    }

    // De los nombres del viaje, solo cambia el propio (y queda un texto de 1 a 30 letras)
    function onlyOwnName() {
      let names = request.resource.data.names;
      return names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && names[request.auth.uid] is string
        && names[request.auth.uid].size() > 0
        && names[request.auth.uid].size() <= 30;
    }

    // ── Viaje compartido: notas por día y por lugar ──────────────────────
    // Quien lo crea invita a UNA persona con el link (el id del viaje es el
    // secreto) y después queda cerrado
    function isTraveler(tripId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/viajes/$(tripId)).data.members;
    }

    // Una nota: el día, opcionalmente un lugar de ese día, y un texto corto
    function validNote(n) {
      return n.day is string && n.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (!('place' in n) || (n.place is string && n.place.size() > 0 && n.place.size() <= 100))
        && n.text is string && n.text.size() > 0 && n.text.size() <= 1000;
    }

    match /viajes/{tripId} {
      // Solo los miembros lo ven (también la búsqueda "mis viajes")
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Se crea con uno solo, quien lo crea, y su nombre
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['slug', 'members', 'names', 'createdAt'])
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('[a-z0-9-]{1,40}')
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] is string
        && request.resource.data.names[request.auth.uid].size() > 0
        && request.resource.data.names[request.auth.uid].size() <= 30
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // Un miembro cambia su propio nombre y nada más
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
          && onlyOwnName())
        ||
        // Link de invitación: alguien de afuera solo puede sumarse a sí mismo,
        // y solo mientras haya un único miembro
        (!(request.auth.uid in resource.data.members)
          && resource.data.members.size() == 1
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyOwnName())
      );

      match /notas/{noteId} {
        allow read: if isTraveler(tripId);

        // Firmada por quien la escribe, con la hora del servidor
        allow create: if isTraveler(tripId)
          && request.resource.data.keys().hasOnly(['day', 'place', 'text', 'author', 'createdAt'])
          && validNote(request.resource.data)
          && request.resource.data.author == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // Cada uno edita solo el texto de las suyas
        allow update: if isTraveler(tripId)
          && resource.data.author == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && validNote(request.resource.data)
          && request.resource.data.editedAt == request.time;

        // Cualquiera de los dos borra (si una sugerencia no va, se saca)
        allow delete: if isTraveler(tripId);
      }
    }
  }
}
